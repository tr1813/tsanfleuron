source ../data/PuitsFonteAstique/PuitsFonteAstique.th 

input ../layouts/detailed-e.thl 

layout local
  copy detailed-e
  scale 1 500
  legend off
  map-header 0 0 off
  symbol-show point label
  symbol-hide point passage-height
  symbol-assign line wall:blocks MYEE
  
  symbol-hide point station-name 
  symbol-hide line survey
  symbol-hide point station
  color map-bg transparent
  symbol-colour line rope [70 10 0]
  symbol-colour line u:deviation [70 10 0]
  symbol-colour point anchor [70 10 0]
  symbol-colour point stalagmite [0 0 0]
  symbol-colour point stalactite [0 0 0]
  symbol-colour point pillar [0 0 0]

  code tex-map
  #\framethickness=0.5mm
  \def\xcenter{0}
  \def\ycenter{0}
  \def\xscale{1}
  \def\yscale{1}
  \legendwidth=10cm
  # change this
  \def\customheader{
  \size[18]\bf \the\cavename{} 
  \si \par \size[14]Commune de Savièse, Valais \ss
  \par{ \quad} 
  \size[14]\par \si Coordonnées :\ss { X: 2'584'263 / Y : 1'129'711 / Altitude : 2650 m  }\ss
  \par \si Développement  :\ss { \the\cavelength}
  \par \si Dénivellation  :\ss { \the\cavedepth}
  \par \si{ Exploration :}\ss{ SCJ, GSP - 2026} 
  \par \si Relevés topographiques  :\ss{ R. Colton, M. Perne, E. Serrat \&  T. Racine} 
  \par \si Report et dessins :\ss{ T. Racine}}
  
  \def\maplayout{
  \legendbox{\the\numexpr\xcenter+5\xscale\relax}{\the\numexpr\ycenter-14*\yscale\relax}{N}{\customheader}
  \legendbox{\the\numexpr\xcenter+50*\xscale\relax}{\the\numexpr\ycenter+51*\yscale\relax}{N}{\scalebar}
  \legendbox{\the\numexpr\xcenter + 25*\xscale\relax}{\the\numexpr\ycenter +40*\yscale\relax}{NW} {\hbox{\loadpicture{"../outputs/PuitsFonteAstique-plan.pdf"}}}

 }
 endcode
endlayout 

select m-all-e@PuitsFonteAstique
export map -o ../outputs/PuitsFonteAstique-extended.pdf -layout local -projection extended
export model -o ../outputs/PuitFonteAstique.3d -fmt survex